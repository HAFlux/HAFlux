{
  "name": "haflux",
  "version": "0.4.0",
  "private": true,
  "description": "Multi-HAProxy control plane: visual management for HAProxy clusters via Data Plane API.",
  "license": "AGPL-3.0-only",
  "homepage": "https://github.com/haflux/haflux",
  "repository": {
    "type": "git",
    "url": "https://github.com/haflux/haflux.git"
  },
  "engines": {
    "node": ">=20.18.0",
    "pnpm": ">=9.15.0"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "pnpm -r --filter './apps/*' --filter './packages/*' run build",
    "dev": "pnpm -r --parallel --filter './apps/api' --filter './apps/web' run dev",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "compose:up": "docker compose -f deploy/docker/compose.yml --env-file deploy/docker/.env up -d --build",
    "compose:down": "docker compose -f deploy/docker/compose.yml --env-file deploy/docker/.env down",
    "compose:logs": "docker compose -f deploy/docker/compose.yml --env-file deploy/docker/.env logs -f",
    "compose:dev": "docker compose -f deploy/docker/compose.yml -f deploy/docker/compose.dev.yml --env-file deploy/docker/.env up --build"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "typescript": "5.9.3"
  },
  "pnpm": {
    "peerDependencyRules": {
      "allowedVersions": {
        "react": "19",
        "react-dom": "19"
      }
    }
  }
}
