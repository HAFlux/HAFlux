# Публичный хост панели (для CORS / cookies)
PUBLIC_HOST=localhost

# Порты
WEB_PORT=8080
API_PORT=3000

# ─── Секреты ─────────────────────────────────────────────────────────────
# Сгенерируйте через ./deploy/docker/scripts/init-secrets.sh
DB_PASSWORD=change-me
JWT_SECRET=change-me-32-bytes-base64
ENCRYPTION_KEY=change-me-32-bytes-base64

# ─── Bootstrap root-пользователя ─────────────────────────────────────────
BOOTSTRAP_ROOT_EMAIL=admin@haflux.local
# Если пусто — пароль будет сгенерирован и выведен в логах api при первом старте.
BOOTSTRAP_ROOT_PASSWORD=

# ─── Postgres ────────────────────────────────────────────────────────────
POSTGRES_DB=haflux
POSTGRES_USER=haflux

# ─── Image (опционально) ────────────────────────────────────────────────
# По умолчанию compose.yml тянет ghcr.io/haflux/api:latest.
# Чтобы зафиксировать конкретный релиз, поставьте версию:
#   HAFLUX_API_TAG=v0.1.0
# или укажите свой образ целиком:
#   HAFLUX_API_IMAGE=registry.example.com/haflux/api:custom
HAFLUX_API_TAG=latest
