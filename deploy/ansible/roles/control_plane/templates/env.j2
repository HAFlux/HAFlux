PUBLIC_HOST={{ ansible_host | default(inventory_hostname) }}
WEB_PORT={{ hapilot_web_port }}
API_PORT={{ hapilot_api_port }}
# Публичные origin'ы UI: через HAProxy (порт 80) и напрямую на nginx (для отладки).
ALLOWED_ORIGINS=http://{{ ansible_host | default(inventory_hostname) }},http://{{ ansible_host | default(inventory_hostname) }}:{{ hapilot_web_port }}

POSTGRES_DB={{ control_plane_postgres_db }}
POSTGRES_USER={{ control_plane_postgres_user }}
DB_PASSWORD={{ hapilot_db_password }}

JWT_SECRET={{ hapilot_jwt_secret }}
ENCRYPTION_KEY={{ hapilot_encryption_key }}

BOOTSTRAP_ROOT_EMAIL={{ hapilot_root_email }}
BOOTSTRAP_ROOT_PASSWORD=
