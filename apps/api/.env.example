NODE_ENV=development
PORT=3000

DATABASE_URL=postgres://hapilot:hapilot@localhost:5432/hapilot
REDIS_URL=redis://localhost:6379

# 32-байтные ключи в base64. В проде генерируются через init-secrets.sh.
JWT_SECRET=changeme-please-32-bytes-base64-xxxxxxxxxxxxx
ENCRYPTION_KEY=changeme-please-32-bytes-base64-xxxxxxxxxxx
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

ALLOWED_ORIGINS=http://localhost:5173

# Bootstrap: при первом запуске создаём root-пользователя с этим email.
# Пароль печатается в логах api при старте, если ROOT_PASSWORD не задан.
BOOTSTRAP_ROOT_EMAIL=admin@hapilot.local
BOOTSTRAP_ROOT_PASSWORD=
