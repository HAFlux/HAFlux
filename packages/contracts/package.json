{
  "name": "@haflux/contracts",
  "version": "0.3.0",
  "private": true,
  "description": "Shared Zod schemas and TypeScript types for HAFlux api/web.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "3.24.1"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "vitest": "2.1.8"
  }
}
